  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.24.0",
    "@playwright/test": "1.58.1",
    "@types/jest": "^29.5.14",
    "@types/node": "22.14.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "^9.34.0",
    "eslint-config-next": "15.2.5",
    "eslint-config-prettier": "10.1.1",
    "jest": "^29.7.0",
