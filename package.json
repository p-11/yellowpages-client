{
  "name": "p11-yellowpages",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:test": "NEXT_PUBLIC_VERCEL_ENV=test NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA next build",
    "start": "next start",
    "lint": "next lint",
